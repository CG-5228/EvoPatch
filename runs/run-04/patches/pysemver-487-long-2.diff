+def _cmp_decimal_strings(a: str, b: str) -> int:
+    """Compare two non-negative decimal integers given as digit strings.
+
+    Leading zeros are stripped first, so the result matches what comparing
+    the corresponding ``int`` objects would yield.  This is used for numbers
+    that are too long for Python's limit on integer-string conversions
+    (see :func:`sys.get_int_max_str_digits`), which makes ``int()`` raise.
+    """
+    a = a.lstrip("0")
+    b = b.lstrip("0")
+    if len(a) != len(b):
+        return (len(a) > len(b)) - (len(a) < len(b))
+    return (a > b) - (a < b)
+
+
+class _LongNumber:
+    """A number that ``int()`` refused to build because its decimal
+    representation is longer than Python's integer-string conversion limit.
+
+    Only ASCII digit strings get here, so the stored digits can be compared
+    numerically as plain strings (after stripping leading zeros) without
+    building an ``int``.
+    """
+
+    __slots__ = ("digits",)
+
+    def __init__(self, digits: str) -> None:
+        self.digits = digits
+
+
