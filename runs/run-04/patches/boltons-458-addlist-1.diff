@@ -270,6 +270,25 @@
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+def test_addlist_iterator():
+    # one-shot iterables (e.g., generators) must behave like lists
+    omd = OMD()
+    omd.addlist('a', (n * 2 for n in range(3)))
+    assert omd.getlist('a') == [0, 2, 4]
+    assert omd.get('a') == 4
+    assert omd.keys() == ['a']
+    assert len(omd) == 1
+    assert list(omd.items()) == [('a', 4)]
+    assert repr(omd) == "OMD([('a', 0), ('a', 2), ('a', 4)])".replace('OMD', omd.__class__.__name__)
+
+    # an empty one-shot iterable adds nothing at all
+    e_omd = OMD()
+    e_omd.addlist('a', iter([]))
+    assert e_omd.keys() == []
+    assert len(e_omd) == 0
+    assert 'a' not in e_omd
+
+
