+    def _increment_attached_style(prerelease: str, token: str) -> Optional[str]:
+        """
+        Increment the counter of a prerelease in the legacy "attached" style,
+        where the counter follows the token directly, without a dot, as in
+        ``rc7`` for the token ``rc``.
+
+        Only the digits directly attached to the token are incremented, so
+        the style and the token of ``prerelease`` are preserved.
+
+        :param prerelease: the prerelease string to increment
+        :param token: the requested prerelease token
+        :return: the incremented string, or None if ``prerelease`` is not in
+            the attached style for ``token``
+        """
+        if not prerelease.startswith(token):
+            return None
+        match = re.match(r"\d+", prerelease[len(token) :])
+        if match is None:
+            return None
+        counter = str(int(match.group()) + 1)
+        rest = prerelease[len(token) + match.end() :]
+        return f"{token}{counter}{rest}"
+
