+def test_addlist_one_shot_iterable():
+    omd = OMD()
+    omd.addlist('a', (n * 2 for n in range(3)))
+    assert omd.getlist('a') == [0, 2, 4]
+    assert omd['a'] == 4
+    assert omd.keys() == ['a']
+    assert len(omd) == 1
+    assert list(omd.iteritems(multi=True)) == [('a', 0), ('a', 2), ('a', 4)]
+
+    omd.addlist('a', iter([6, 8]))
+    assert omd.getlist('a') == [0, 2, 4, 6, 8]
+    assert omd['a'] == 8
+
+    e_omd = OMD()
+    e_omd.addlist('a', iter([]))
+    assert e_omd.keys() == []
+    assert len(e_omd) == 0
+    assert 'a' not in e_omd
+
+
