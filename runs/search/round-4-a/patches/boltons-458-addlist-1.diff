+def test_qpd_addlist_one_shot_iterable():
+    qpd = QueryParamDict()
+    qpd.addlist('k', (str(n) for n in range(3)))
+    assert qpd.getlist('k') == ['0', '1', '2']
+    assert qpd['k'] == '2'
+    assert qpd.to_text() == 'k=0&k=1&k=2'
+
+    qpd.addlist('k', iter(['3']))
+    assert qpd.getlist('k') == ['0', '1', '2', '3']
+
+    empty = QueryParamDict()
+    empty.addlist('k', iter([]))
+    assert empty.keys() == []
+    assert len(empty) == 0
+    assert 'k' not in empty
