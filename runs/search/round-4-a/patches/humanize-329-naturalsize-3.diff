+def _reaches_base(fmt: str, value: float, base: int) -> bool:
+    """Whether ``value`` formatted with ``fmt`` displays a number >= ``base``."""
+    text = fmt % value
+    try:
+        return abs(float(text)) >= base
+    except ValueError:
+        pass
+    # The format wraps the number in other text. Find the number that comes
+    # from ``value`` by formatting a perturbed value: literal text does not
+    # change, only the number rendered from the value does.
+    pattern = r"[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?"
+    shown = re.findall(pattern, text)
+    shifted = re.findall(pattern, fmt % (value + max(1.0, abs(value) * 0.01)))
+    for candidate, other in zip(shown, shifted):
+        if candidate != other:
+            return abs(float(candidate)) >= base
+    return False
