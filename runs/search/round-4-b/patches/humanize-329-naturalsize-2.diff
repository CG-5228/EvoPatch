+
+    # The scaled number can round up to the base when formatted (e.g.
+    # 999.96 shows as "1000.0" with "%.1f"). When that happens, carry into
+    # the next unit so the number and its suffix stay in sync. Stop at the
+    # largest unit: there is nothing bigger to carry into.
+    while exp < len(suffix):
+        shown = format % (bytes_ / (base**exp))
+        try:
+            rounds_up = abs(float(shown)) >= base
+        except ValueError:
+            rounds_up = False
+        if not rounds_up:
+            break
+        exp += 1
+
