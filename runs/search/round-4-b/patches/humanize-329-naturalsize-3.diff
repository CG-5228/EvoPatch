+
+    # The value is scaled with the exponent truncated, but the formatted
+    # number can round up to (or past) the base, e.g. 999960 bytes becomes
+    # "1000.0 kB". In that case the unit has to move up along with the
+    # number, otherwise the display reads "1000.0 kB" instead of "1.0 MB".
+    # The largest unit is the exception: there is nothing bigger to move up
+    # to, so it keeps showing even if the number rounds past the base.
+    while exp < len(suffix):
+        scaled = bytes_ / (base**exp)
+        try:
+            rounded = float(format % scaled)
+        except (TypeError, ValueError):
+            # A custom format whose output we cannot read back as a number;
+            # fall back to the value itself.
+            rounded = scaled
+        if abs(rounded) < base:
+            break
+        exp += 1
+
     ret: str = format % (bytes_ / (base**exp)) + space + _(suffix[exp - 1])
