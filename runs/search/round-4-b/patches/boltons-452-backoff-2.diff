-        denom = start if start else 1
-        count = 1 + math.ceil(math.log(stop/denom, factor))
-        count = count if start else count + 1
+        if factor == 1.0:
+            # A factor of 1.0 yields a flat sequence, so the value of
+            # stop can only be reached when it is already the current
+            # value (or via the special zero-start behavior below); no
+            # count can be computed when a larger stop must be climbed.
+            if start == stop:
+                count = 1
+            elif start == 0.0 and 0.0 < stop <= 1.0:
+                # start == 0.0: the generator yields the zero, steps to
+                # 1, then clamps to stop, reaching it on the second step.
+                count = 2
+            else:
+                raise ValueError(
+                    'expected factor > 1.0 when count is omitted, not'
+                    ' %r; a flat sequence (factor=1.0) never reaches'
+                    ' stop=%r from start=%r; pass count explicitly to'
+                    ' get a flat sequence' % (factor, stop, start))
+        else:
+            denom = start if start else 1
+            count = 1 + math.ceil(math.log(stop/denom, factor))
+            count = count if start else count + 1
