diff -ruN -x __pycache__ -x *.pyc -x .pytest_cache -x node_modules -x *.orig -x *.rej -x .DS_Store a/probe.py b/probe.py
--- a/probe.py	1970-01-01 00:00:00
+++ b/probe.py	2026-11-08 13:59:47
@@ -0,0 +1,25 @@
+from boltons.iterutils import backoff_iter
+cases = [
+    dict(start=2.0, stop=30.0, factor=1.0),
+    dict(start=2.0, stop=30.0, count=4, factor=1.0),
+    dict(start=0.0, stop=1.0, factor=1.0),
+    dict(start=0.0, stop=0.5, factor=1.0),
+    dict(start=0.0, stop=0.0, factor=1.0),
+    dict(start=5.0, stop=5.0, factor=1.0),
+    dict(start=5.0, stop=6.0, factor=1.0),
+    dict(start=0.0, stop=16.0, factor=1.0),
+    dict(start=0.0, stop=1.0000001, factor=1.0),
+    dict(start=1.0, stop=1.0, factor=1.0),
+    dict(start=0.0, stop=2.0, factor=1.0000000001),
+    dict(start=0.0, stop=1.0, factor=1.0000000001),
+    dict(start=1.0, stop=10.0, factor=1.0000000001),
+    dict(start=2.0, stop=30.0, factor=1.0, jitter=0.5),
+    dict(start=0.0, stop=0.0, factor=1.0, count='repeat'),
+]
+for c in cases:
+    name = repr(c)
+    try:
+        res = list(backoff_iter(**c))
+        print("OK  ", name, "->", res[:8], "len=%s" % (len(res) if len(res)<50 else 'big'))
+    except Exception as e:
+        print("RAISE", name, "->", type(e).__name__, str(e)[:160])
