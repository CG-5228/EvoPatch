+def test_backoff_unit_factor():
+    from boltons.iterutils import backoff, backoff_iter
+
+    # explicit count yields a flat sequence
+    assert list(backoff_iter(2.0, 30.0, count=4, factor=1.0)) == [2.0] * 4
+    assert backoff(2.0, 30.0, count=4, factor=1.0) == [2.0] * 4
+    # 'repeat' is unaffected
+    assert next(backoff_iter(5, 5, count="repeat", factor=1.0)) == 5.0
+
+    # inferring a count is impossible: a flat sequence cannot climb to a
+    # larger stop; must be a descriptive ValueError, not ZeroDivisionError
+    with pytest.raises(ValueError):
+        list(backoff_iter(2.0, 30.0, factor=1.0))
+    with pytest.raises(ValueError):
+        backoff(2.0, 30.0, factor=1.0)
+    with pytest.raises(ValueError):
+        list(backoff_iter(0, 16, factor=1.0))
+
+    # flat sequence already at stop is inferrable
+    assert list(backoff_iter(5.0, 5.0, factor=1.0)) == [5.0]
+
