+def test_backoff_factor_one_requires_count():
+    from boltons.iterutils import backoff, backoff_iter
+
+    # factor=1.0 passes validation, so omitting count must raise a
+    # descriptive ValueError rather than a raw ZeroDivisionError
+    with pytest.raises(ValueError):
+        list(backoff_iter(2.0, 30.0, factor=1.0))
+    with pytest.raises(ValueError):
+        backoff(2.0, 30.0, factor=1.0)
+    with pytest.raises(ValueError):
+        list(backoff_iter(0, 16, factor=1.0))
+
+    # an explicit count still yields a flat sequence
+    assert list(backoff_iter(2.0, 30.0, count=4, factor=1.0)) == [2.0] * 4
+
+    # counts that can be worked out still are
+    assert list(backoff_iter(2.0, 2.0, factor=1.0)) == [2.0]
+    assert list(backoff_iter(0, 1, factor=1.0)) == [0.0, 1]
+
