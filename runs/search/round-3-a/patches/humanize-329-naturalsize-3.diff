         return f"{int(bytes_)}B" if gnu else _("%d Bytes") % int(bytes_)
 
     exp = int(min(log(abs_bytes, base), len(suffix)))
+    # ``log`` can round up at a boundary, leaving the scaled value below 1;
+    # demote in that case so the unit and the number stay in step.
