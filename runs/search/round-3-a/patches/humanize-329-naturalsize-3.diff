+
+_FORMATTED_NUMBER = re.compile(r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?")
+
+# The single value conversion a ``format`` template applies (``%%`` is an
+# escaped literal, never a conversion).
+_CONVERSION_SPEC = re.compile(r"%(?:[-+ #0]*)(?:\d+)?(?:\.\d+)?[diouxXeEfFgGrsa]")
+
+
+def _displayed_magnitude(format: str, value: float) -> float | None:
+    """Absolute number as ``format`` renders ``value``, or ``None``.
+
+    ``None`` means the formatted text does not expose a parseable number,
+    in which case the exponent must be left alone.
+    """
+    try:
+        rendered = format % value
+    except (TypeError, ValueError):
+        return None
+    field = rendered
+    spec = _CONVERSION_SPEC.search(format)
+    if spec is not None:
+        # Strip the template's literal prefix/suffix so that digits written
+        # into the template itself are not mistaken for the rendered value.
+        prefix = format[: spec.start()].replace("%%", "%")
+        suffix = format[spec.end() :].replace("%%", "%")
+        if (
+            rendered.startswith(prefix)
+            and rendered.endswith(suffix)
+            and len(rendered) >= len(prefix) + len(suffix)
+        ):
+            field = rendered[len(prefix) : len(rendered) - len(suffix)]
+    match = _FORMATTED_NUMBER.search(field)
+    if match is None:
+        return None
+    try:
+        return abs(float(match.group()))
+    except ValueError:
+        return None
