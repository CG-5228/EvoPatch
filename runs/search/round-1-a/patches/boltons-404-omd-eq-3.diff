diff -ruN -x __pycache__ -x *.pyc -x .pytest_cache -x node_modules -x *.orig -x *.rej -x .DS_Store a/boltons/dictutils.py b/boltons/dictutils.py
--- a/boltons/dictutils.py	1970-01-01 00:00:00
+++ b/boltons/dictutils.py	2026-11-06 22:03:42
@@ -356,10 +356,22 @@
                 return False
             return True
         elif hasattr(other, 'keys'):
+            try:
+                if set(other.keys()) != set(self.keys()):
+                    return False
+            except TypeError:
+                # unhashable keys on either side; fall back to the
+                # key-by-key lookups below
+                pass
             for selfk in self:
                 try:
-                    other[selfk] == self[selfk]
+                    otherv = other[selfk]
                 except KeyError:
+                    return False
+                selfv = self[selfk]
+                # match dict semantics: identical values compare equal
+                # even when they are not ==-equal (e.g., NaN)
+                if not (otherv is selfv or otherv == selfv):
                     return False
             return True
         return False
