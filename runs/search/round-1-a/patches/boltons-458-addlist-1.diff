+def test_addlist_one_shot_iterators():
+    # one-shot iterators (generators) must behave like the equivalent list
+    omd = OMD()
+    omd.addlist('k', (n * 2 for n in range(3)))
+    assert omd.getlist('k') == [0, 2, 4]
+    assert omd.get('k') == 4
+    assert omd.keys() == ['k']
+    assert len(omd) == 1
+    assert repr(omd) == "OrderedMultiDict([('k', 0), ('k', 2), ('k', 4)])"
+
+    # appending from an iterator preserves existing values
+    omd.addlist('k', iter([6, 8]))
+    assert omd.getlist('k') == [0, 2, 4, 6, 8]
+
+    # an empty iterator adds nothing at all
+    e_omd = OMD([('k', 1)])
+    e_omd.addlist('other', iter([]))
+    assert e_omd.keys() == ['k']
+    assert len(e_omd) == 1
+    assert 'other' not in e_omd
+
+    # same contract on the urlutils side
+    from boltons.urlutils import QueryParamDict
+    qp = QueryParamDict()
+    qp.addlist('a', (c for c in 'xy'))
+    assert qp.getlist('a') == ['x', 'y']
+    assert qp.to_text() == 'a=x&a=y'
+    e_qp = QueryParamDict()
+    e_qp.addlist('a', iter([]))
+    assert len(e_qp) == 0
+    assert 'a' not in e_qp
+
+
 def test_pop_all():
