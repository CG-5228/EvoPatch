+// Is `version` in the simple range `set`, using the same rules that
+// Range#test applies: every comparator must pass on version ordering,
+// and a version with a prerelease must match a comparator with a
+// prerelease in the same tuple, unless includePrerelease is set.
+const setHas = (version, set, options = {}) => {
+  if (options.includePrerelease) {
+    return set.every(c => c.test(version))
+  }
+  const isSemVer = version instanceof SemVer
+  if (!isSemVer) {
+    version = new SemVer(version, options)
+  }
+  if (version.prerelease.length) {
