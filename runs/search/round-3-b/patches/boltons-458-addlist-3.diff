diff -ruN -x __pycache__ -x *.pyc -x .pytest_cache -x node_modules -x *.orig -x *.rej -x .DS_Store a/boltons/dictutils.py b/boltons/dictutils.py
--- a/boltons/dictutils.py	1970-01-01 00:00:00
+++ b/boltons/dictutils.py	2026-11-07 06:01:58
@@ -223,8 +223,25 @@
         OrderedMultiDict([('a', -1), ('a', 0), ('a', 1), ('a', 2)])
 
         Called ``addlist`` for consistency with :meth:`getlist`, but
-        tuples and other sequences and iterables work.
+        tuples and other sequences and iterables work, including
+        one-shot iterators such as generators. An empty iterable adds
+        nothing.
+
+        >>> omd.addlist('b', (x * 2 for x in range(3)))
+        >>> omd.getlist('b')
+        [0, 2, 4]
+        >>> omd.addlist('c', iter([]))
+        >>> 'c' in omd
+        False
         """
+        try:
+            v = list(v)
+        except TypeError:
+            # not iterable at all; keep the historical lenient no-op
+            # for falsy inputs (e.g., None), otherwise re-raise
+            if not v:
+                return
+            raise
         if not v:
             return
         self_insert = self._insert
