+    @classmethod
+    def _prerelease_parts(
+        cls, value: Optional[str]
+    ) -> List[Union[int, str, _HugeNumber]]:
+        """
+        Split a prerelease into its dot-separated identifiers and turn each
+        numeric identifier into an int, so that :meth:`_nat_cmp` can compare
+        them.
+
+        Identifiers exceeding Python's limit for integer string conversion
+        are represented by a :class:`_HugeNumber` -- but only when the whole
+        prerelease is a valid semver prerelease.  Anything :meth:`parse`
+        rejects behaves exactly as before (the ``ValueError`` from ``int``
+        propagates), so comparing such values keeps raising as it used to.
+        """
+        value = value or ""
+        limit_free = cls._FULL_PRERELEASE.fullmatch(value) is not None
+        parts: List[Union[int, str, _HugeNumber]] = []
+        for identifier in value.split("."):
+            if not identifier.isdigit():
+                parts.append(identifier)
+                continue
+            try:
+                parts.append(int(identifier))
+            except ValueError:
+                # For an all-digit ASCII string, int() can only fail because
+                # the identifier exceeds the integer string conversion limit.
+                # A valid semver prerelease identifier of that size is still
+                # a legal numeric identifier, so keep it comparable.
+                if limit_free and identifier.isascii():
+                    parts.append(_HugeNumber(identifier))
+                else:
+                    raise
+        return parts
 
