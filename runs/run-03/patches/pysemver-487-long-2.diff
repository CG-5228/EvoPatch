+class _HugeNumber:
+    """
+    A numeric prerelease identifier too long to convert to :class:`int`.
+
+    Python limits decimal string to integer conversion (see
+    :func:`sys.get_int_max_str_digits`).  Identifiers exceeding that limit
+    cannot be converted, but they still have to take part in the natural
+    (numeric) ordering of prerelease identifiers.  Keeping their digits in
+    normalized form (no leading zeros) allows comparing them as integers:
+    first by number of digits, then lexicographically.
+    """
+
+    __slots__ = ("digits",)
+
+    def __init__(self, value: str) -> None:
+        stripped = value.lstrip("0")
+        self.digits = stripped or "0"
+
+    @property
+    def key(self) -> Tuple[int, str]:
+        return (len(self.digits), self.digits)
+
+
+def _int_sort_key(value: int) -> Tuple[int, str]:
+    """Sort key with the same ordering as ``value`` for non-negative ints."""
+    digits = str(value)
+    return (len(digits), digits)
+
