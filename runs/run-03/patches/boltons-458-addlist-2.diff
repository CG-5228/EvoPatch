diff -ruN -x __pycache__ -x *.pyc -x .pytest_cache -x node_modules -x *.orig -x *.rej -x .DS_Store a/tests/test_dictutils.py b/tests/test_dictutils.py
--- a/tests/test_dictutils.py	1970-01-01 00:00:00
+++ b/tests/test_dictutils.py	2026-11-06 17:37:58
@@ -270,6 +270,33 @@
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+def test_addlist_iter():
+    "one-shot iterators must behave exactly like the equivalent list"
+    omd = OMD()
+    omd.addlist('k', (n * 2 for n in range(3)))
+    assert omd.getlist('k') == [0, 2, 4]
+    assert omd.get('k') == 4
+    assert omd.keys() == ['k']
+    assert len(omd) == 1
+    assert list(omd.iteritems(multi=True)) == [('k', 0), ('k', 2), ('k', 4)]
+
+    eq_omd = OMD()
+    eq_omd.addlist('k', [0, 2, 4])
+    assert omd == eq_omd
+
+    # an empty iterator adds nothing
+    e_omd = OMD()
+    e_omd.addlist('k', iter([]))
+    assert len(e_omd) == 0
+    assert e_omd.keys() == []
+    assert 'k' not in e_omd
+
+    # existing values under the key are preserved
+    p_omd = OMD([('a', -1)])
+    p_omd.addlist('a', iter(range(3)))
+    assert p_omd.getlist('a') == [-1, 0, 1, 2]
+
+
 def test_pop_all():
     omd = OMD()
     omd.add('even', 0)
