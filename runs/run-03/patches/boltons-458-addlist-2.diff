+def test_query_param_dict_addlist_iter():
+    "one-shot iterators must behave exactly like the equivalent list"
+    qpd = QueryParamDict()
+    qpd.addlist('k', (str(n) for n in range(3)))
+    assert qpd.getlist('k') == ['0', '1', '2']
+    assert qpd.get('k') == '2'
+    assert qpd == QueryParamDict([('k', '0'), ('k', '1'), ('k', '2')])
+
+    e_qpd = QueryParamDict()
+    e_qpd.addlist('k', iter([]))
+    assert len(e_qpd) == 0
+    assert 'k' not in e_qpd
