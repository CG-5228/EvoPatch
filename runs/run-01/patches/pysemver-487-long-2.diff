+def _cmp_num_str(a: str, b: str) -> int:
+    """Compare two all-digit strings as non-negative integers.
+
+    Like ``_cmp(int(a), int(b))`` but without converting to ``int``, so
+    that identifiers longer than ``sys.get_int_max_str_digits()`` compare
+    fine.  Leading zeros are ignored, exactly as ``int()`` would.
+    """
+    a = a.lstrip("0")
+    b = b.lstrip("0")
+    if len(a) != len(b):
+        return 1 if len(a) > len(b) else -1
+    return _cmp(a, b)
+
