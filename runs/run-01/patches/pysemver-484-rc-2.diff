+    def _increment_decimal(string: str) -> str:
+        """
+        Add one to a string of decimal digits, keeping the original width
+        when possible (``"7" -> "8"``, ``"007" -> "008"``) and growing on
+        overflow (``"99" -> "100"``).
+
+        In contrast to :class:`int`, this never fails, no matter how many
+        digits the string has (``int()`` is limited to 4300 digits).
+
+        :param string: the decimal digits to increase
+        :return: the incremented string
+        """
+        digits = list(string)
+        for index in range(len(digits) - 1, -1, -1):
+            if digits[index] != "9":
+                digits[index] = chr(ord(digits[index]) + 1)
+                return "".join(digits)
+            digits[index] = "0"
+        return "1" + "".join(digits)
+
