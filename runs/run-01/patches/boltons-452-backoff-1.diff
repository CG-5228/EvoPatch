+def test_backoff_factor_one_no_count():
+    import pytest
+    from boltons.iterutils import backoff, backoff_iter
+
+    with pytest.raises(ValueError):
+        list(backoff_iter(2.0, 30.0, factor=1.0))
+    with pytest.raises(ValueError):
+        backoff(2, 30, factor=1.0)
+
+    # explicit count still yields a flat sequence
+    assert list(backoff_iter(2.0, 30.0, count=4, factor=1.0)) == [2.0] * 4
+    # count omitted + factor=1.0 is rejected even with a zero start
+    with pytest.raises(ValueError):
+        list(backoff_iter(0.0, 30.0, factor=1.0))
+
