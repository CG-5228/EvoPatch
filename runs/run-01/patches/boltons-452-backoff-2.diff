+from boltons.iterutils import backoff, backoff_iter
+cases = [((5,5), dict(count='repeat')),
+         ((2.0,2.0), dict(count='repeat', factor=1.0)),
+         ((3,3), dict(factor=1.5)),
+         ((0,0), dict()),
+         ((0,1), dict(factor=1.0)),
+         ((1,1), dict()),
+         ((0,10), dict(count='repeat', factor=1.0)),
+         ((0,2.9), dict(factor=1.2)),
+         ((0,16), dict(count='repeat')),
+         ((1,10), dict(factor=1.0, count=0)),
+         ((1,10), dict(factor=1.0, count=-1)),
+         ((1,1), dict(count=0)),
+        ]
+for a,k in cases:
+    try:
+        print(a,k,'->', list(backoff_iter(*a, **k))[:8], flush=True)
+    except Exception as e:
+        print(a,k,'-> RAISED', type(e).__name__, e, flush=True)
+it = backoff_iter(5,5,count='repeat')
+print('repeat5:', [next(it) for _ in range(3)], flush=True)
+try:
+    print('backoff(1,1,1.0):', backoff(1,1,factor=1.0), flush=True)
+except Exception as e:
+    print('backoff RAISED', type(e).__name__, e, flush=True)
+print('END', flush=True)
