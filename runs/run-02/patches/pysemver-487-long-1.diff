+    @staticmethod
+    def _identifier_as_int(value: str) -> "Union[int, _LongNumber]":
+        """
+        Convert a numeric prerelease identifier to an int.
+
+        All-digit identifiers longer than Python's integer string conversion
+        limit (4300 digits by default since Python 3.11) are legal SemVer and
+        must stay comparable, so they are wrapped in a _LongNumber instead of
+        raising ValueError.
+
+        :param value: the identifier to convert
+        :raises ValueError: if the identifier is not a valid integer literal
+        """
+        try:
+            return int(value)
+        except ValueError:
+            if value.isdecimal():
+                # int() only rejects a decimal-only string when it exceeds
+                # the integer string conversion limit (invalid digits such as
+                # "²" are rejected above, before any limit is consulted).
+                return _LongNumber(value)
+            raise
