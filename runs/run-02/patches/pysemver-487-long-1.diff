+class _LongNumber:
+    """
+    An all-digit identifier too long for Python's integer string conversion.
+
+    SemVer allows prerelease identifiers of unlimited length, so such
+    identifiers are compared numerically as decimal digit strings instead
+    of being converted to :class:`int`.
+    """
+
+    __slots__ = ("digits",)
+
+    def __init__(self, digits: str):
+        #: The decimal digits of the number (kept verbatim)
+        self.digits = digits
+
+    @staticmethod
+    def _cmp_number(a: "Union[int, _LongNumber]", b: "Union[int, _LongNumber]") -> int:
+        """Compare two numeric identifiers without hitting the digit limit."""
+        a_digits = str(a) if isinstance(a, int) else a.digits
+        b_digits = str(b) if isinstance(b, int) else b.digits
+        # Normalize away leading zeros so equal values compare equal
+        a_digits = a_digits.lstrip("0") or "0"
+        b_digits = b_digits.lstrip("0") or "0"
+        # Equal-length decimal digit strings compare by their digits alone
+        return _cmp(a_digits, b_digits) if len(a_digits) == len(b_digits) else _cmp(
+            len(a_digits), len(b_digits)
+        )
+
+
