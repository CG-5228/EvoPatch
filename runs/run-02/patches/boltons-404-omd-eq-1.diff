+@dataclass(frozen=True, slots=True)
+class InstallationCandidate:
+    """Represents a potential "candidate" for installation."""
+
+    name: str
+    version: Version
+    link: Link
+    locked: bool
+
+    def __init__(
+        self, name: str, version: str, link: Link, locked: bool = False
+    ) -> None:
+        object.__setattr__(self, "name", name)
