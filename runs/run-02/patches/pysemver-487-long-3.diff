+    def _cmp_numeric_str(a: str, b: str) -> int:
+        """
+        Compare two all-digit strings as non-negative integers, without
+        converting them to :class:`int`.
+
+        Equivalent to ``_cmp(int(a), int(b))``, but safe for identifiers
+        longer than :func:`sys.get_int_max_str_digits` digits, where the
+        int() conversion itself would raise :exc:`ValueError`.
+
+        Leading zeros are handled the way integer conversion would handle
+        them, so the result always matches ``_cmp(int(a), int(b))``.
+        """
+        a_digits = a.lstrip("0")
+        b_digits = b.lstrip("0")
+        if len(a_digits) != len(b_digits):
+            # Fewer significant digits means a smaller magnitude.
+            return _cmp(len(a_digits), len(b_digits))
+        # Equal length: lexicographic order equals numeric order for equal-
+        # length digit strings without leading zeros.  Equal significant
+        # digits means equal value, even if the number of leading zeros
+        # differs (e.g. "007" == "7").
+        return _cmp(a_digits, b_digits)
