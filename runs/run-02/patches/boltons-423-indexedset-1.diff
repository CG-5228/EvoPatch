+s.remove(90)
+print('removed 90 dead', [tuple(d) for d in s.dead_indices])
+s.add(100)
+s.add(101)
+print('after adds: items_len', len(s.item_list), 'dead', [tuple(d) for d in s.dead_indices], 'live', len(s))
+ref = list(s)
+print('ref tail', ref[-4:], 'len', len(ref))
+bad = []
+for i in range(len(ref)):
+    try:
