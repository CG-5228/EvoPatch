+from boltons.setutils import IndexedSet
+
+# --- reported cases: should all be fixed ---
+s = IndexedSet('abcdefghij'); s.remove('c')
+print('slice fwd', list(s[2:5]), 'slice neg', list(s[-2:]))
+for i in (-10, -15):
+    try: print('getitem', i, s[i])
+    except IndexError as e: print('getitem', i, 'IndexError', e)
+for i in (-10, -15, 9):
+    try: print('pop', i, s.pop(i))
+    except IndexError as e: print('pop', i, 'IndexError', e)
+
+# --- finding 1: silent wrong data still reachable ---
+t = IndexedSet(range(100))
+for v in (90, 97, 98, 96, 99):
+    t.remove(v)
+t.add(100); t.add(101)
+ref = list(t)
+print('len(t)=', len(t), 'dead=', [tuple(d) for d in t.dead_indices], 'item_list_len=', len(t.item_list))
+print('t[95] =', t[95], ' list(t)[95] =', ref[95])
+try:
+    print('t[96] =', t[96])
+except IndexError as e:
+    print('t[96] raised IndexError:', e, ' but len =', len(t))
+u = IndexedSet(range(100))
+for v in (90, 97, 98, 96, 99): u.remove(v)
+u.add(100); u.add(101)
+print('pop(95) ->', u.pop(95), 'expected', ref[95], 'remaining', list(u) == ref[:95] + ref[96:])
+
+# --- finding 2: helper still unbounded / double normalizing ---
+h = IndexedSet('abcdefghij'); h.remove('c')   # len 9
+print('_get_real_index(-15) =', h._get_real_index(-15), '(still negative; item_list wrap would give',
+      h.item_list[h._get_real_index(-15)] if abs(h._get_real_index(-15)) <= len(h.item_list) else 'out of range', ')')
+print('_get_real_index(9) =', h._get_real_index(9), 'len(item_list)=', len(h.item_list))
+
+# --- finding 3 (minor): empty-set pop message ---
+try: IndexedSet().pop(-1)
+except IndexError as e: print('IndexedSet().pop(-1):', e, ' | [].pop(-1):', end=' ')
+try: [].pop(-1)
+except IndexError as e: print(e)
