+print('getitem problems:', bad[:10])
+# pop
+t = IndexedSet(range(100))
+for v in (97, 98, 96, 99, 90): t.remove(v)
+t.add(100); t.add(101)
+for i in (0, 5, 89, 90, 94, 95, -1, -5, -95):
+    tt = IndexedSet(range(100))
+    for v in (97, 98, 96, 99, 90): tt.remove(v)
