+from boltons.setutils import IndexedSet
+
+def build():
+    s = IndexedSet(range(100))
+    for v in (90, 97, 98, 96, 99):
+        s.remove(v)
+    s.add(100)
+    s.add(101)
+    return s
+
+s = build()
+print('items_len', len(s.item_list), 'dead', [tuple(d) for d in s.dead_indices], 'live', len(s))
+ref = list(s)
+print('ref tail', ref[-4:], 'len', len(ref))
+bad = []
+for i in range(len(ref)):
+    try:
+        got = s[i]
+    except Exception as e:
+        bad.append((i, 'raised', type(e).__name__, str(e)))
+        continue
+    if got != ref[i]:
+        bad.append((i, 'wrong', got, ref[i]))
+print('getitem problems:', bad[:10])
+
+# slices still ok?
+print('slice fwd', list(s[90:97]) == ref[90:97], list(s[:3]) == ref[:3], list(s[-3:]) == ref[-3:])
+
+# pop
+for i in (0, 5, 89, 90, 94, 95, 96-1, -1, -2, -5, -95, -97):
+    tt = build()
+    r = list(tt)
+    j = i if i >= 0 else len(r) + i
+    try:
+        got = tt.pop(i)
+    except Exception as e:
+        print('pop(%d) raised %s: %s (expected %r)' % (i, type(e).__name__, e, r[j])); continue
+    exp = r[j]
+    ok = got == exp and list(tt) == r[:j] + r[j+1:]
+    print('pop(%d) got %r exp %r %s' % (i, got, exp, 'OK' if ok else 'FAIL'))
