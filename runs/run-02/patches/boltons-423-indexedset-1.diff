@@ -0,0 +1,75 @@
+import random, time
+from boltons.setutils import IndexedSet
+random.seed(7)
+t0 = time.time()
+probs = []
+N = 2000
+for trial in range(N):
+    n = random.randint(0, 14)
+    ref = list(range(n))
+    s = IndexedSet(ref)
+    for step in range(random.randint(1, 12)):
+        ops = ['pop', 'remove', 'discard', 'add', 'insert_chk']
+        op = random.choice(ops)
+        if not ref:
+            op = 'add'
+        if op == 'pop':
+            i = random.randint(-len(ref)-3, len(ref)+2)
+            try:
+                a = s.pop(i); ae = None
+            except Exception as e:
+                a, ae = None, type(e).__name__
+            try:
+                b = ref.pop(i); be = None
+            except Exception as e:
+                b, be = None, type(e).__name__
+            if ae != be or (not ae and a != b):
+                probs.append(('pop', list(ref), i, a, ae, b, be)); break
+        elif op == 'remove':
+            v = random.choice(ref)
+            try: s.remove(v); se = None
+            except Exception as e: se = type(e).__name__
+            try: ref.remove(v); re_ = None
+            except Exception as e: re_ = type(e).__name__
+            if se != re_: probs.append(('remove', v, se, re_)); break
+        elif op == 'discard':
+            v = random.choice(ref) if ref else None
+            s.discard(v); 
+            if v in ref: ref.remove(v)
+        else:
+            v = random.randint(0, 20)
+            s.add(v)
+            if v not in ref: ref.append(v)
+        # state agreement
+        if list(s) != ref:
+            probs.append(('state', op, list(s), ref)); break
+        for k in list(range(-len(ref)-3, len(ref)+3)):
+            try: x = s[k]; xe = None
+            except Exception as e: x, xe = None, type(e).__name__
+            try: y = ref[k]; ye = None
+            except Exception as e: y, ye = None, type(e).__name__
+            if xe != ye or (not xe and x != y):
+                probs.append(('getitem', list(ref), k, x, xe, y, ye)); break
+        if probs: break
+        fresh = IndexedSet(ref)
+        for a in (None, -17, -13, -6, -1, 0, 4, 9, 13, 17):
+            for b in (None, -17, -13, -6, -1, 0, 4, 9, 13, 17):
+                for c in (None, -5, -2, -1, 1, 2, 5):
+                    sl = slice(a, b, c)
+                    try: g = list(s[sl]); ge = None
+                    except Exception as e: g, ge = None, type(e).__name__
+                    try: h = ref[sl]; he = None
+                    except Exception as e: h, he = None, type(e).__name__
+                    if (c is None or c > 0) and (ge != he or (not ge and g != h)):
+                        probs.append(('slice-list', list(ref), sl, g, ge, h, he)); break
+                    try: f = list(fresh[sl]); fe = None
+                    except Exception as e: f, fe = None, type(e).__name__
+                    if ge != fe or (not ge and g != f):
+                        probs.append(('slice-fresh', list(ref), sl, g, ge, f, fe)); break
+                if probs: break
+            if probs: break
+        if probs: break
+    if probs: break
+    if trial % 200 == 0:
+        print(trial, 'elapsed', round(time.time()-t0, 1), flush=True)
+print('RESULT probs:', probs[:5])
