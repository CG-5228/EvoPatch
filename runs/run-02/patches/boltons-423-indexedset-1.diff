+from itertools import product, combinations
+from boltons.setutils import IndexedSet
+
+def run(ops):
+    ref = list(range(10))
+    s = IndexedSet(range(10))
+    for op in ops:
+        kind, i = op
+        try:
+            if kind == 'pop':
+                a = s.pop(i); b = ref.pop(i)
+                if a != b: return ('popval', ops, a, b)
+            elif kind == 'rm':
+                v = ref[i]; s.remove(v); ref.remove(v)
+            elif kind == 'ds':
+                v = ref[i]; s.discard(v); ref.remove(v)
+        except Exception as e:
+            try:
+                ref.pop(i) if kind=='pop' else (ref.remove(ref[i]) if kind=='rm' else (ref.pop(i), ref.pop(i-1))[0])
+                return ('err-mismatch', ops, type(e).__name__)
+            except Exception as e2:
+                if type(e) is not type(e2): return ('errtype', ops, type(e).__name__, type(e2).__name__)
+                return None
+        # check full state agreement
+        if list(s) != ref: return ('state', ops, list(s), ref)
+        for k in list(range(-len(ref)-2, len(ref)+2)):
+            try: x = s[k]; xe = None
+            except Exception as e: x = None; xe = type(e).__name__
+            try: y = ref[k]; ye = None
+            except Exception as e: y = None; ye = type(e).__name__
+            if xe != ye or (not xe and x != y):
+                return ('getitem', ops, k, x, xe, y, ye)
+        # slices (positive step vs list; all steps vs fresh)
+        fresh = IndexedSet(ref)
+        for a in (None,-13,-11,-6,-1,0,3,7,11,13):
+            for b in (None,-13,-11,-6,-1,0,3,7,11,13):
+                for c in (None,-4,-2,-1,1,2,4):
+                    sl = slice(a,b,c)
+                    try: g = list(s[sl]); ge=None
+                    except Exception as e: ge = type(e).__name__; g=None
+                    try: h = ref[sl]; he=None
+                    except Exception as e: he = type(e).__name__; h=None
+                    if c is None or c > 0:
+                        if ge != he or (not ge and g != h):
+                            return ('slice-list', ops, sl, g, ge, h, he)
+                    try: f = list(fresh[sl]); fe=None
+                    except Exception as e: fe = type(e).__name__; f=None
+                    if ge != fe or (not ge and g != f):
+                        return ('slice-fresh', ops, sl, g, ge, f, fe)
+        if not s: return None
+    return None
+
+probs = []
+# sequences: removals then pops
+kinds = ['pop','rm','ds']
+for plen in (0,1,2):
+  for seq in product(range(10), repeat=plen):
+    for k in range(4):
+      for rmseq in product(range(10), repeat=k):
+        ops = [('rm', i) for i in rmseq] + [('pop', i) for i in seq]
+        r = run(ops)
+        if r: probs.append(r)
+        if len(probs) > 8: break
+      if len(probs) > 8: break
+    if len(probs) > 8: break
+  if len(probs) > 8: break
+print('probs:', len(probs))
+for p in probs[:8]: print(p)
