+from boltons.setutils import IndexedSet
+s = IndexedSet(range(100))
+for v in (99, 90, 98):
+    s.remove(v)
+print('items len', len(s.item_list), 'dead', s.dead_indices, 'live', len(s))
+s.add(100)
+s.add(101)
+print('items len', len(s.item_list), 'dead', s.dead_indices, 'live', len(s), 'list tail', list(s)[-3:])
+for i in range(len(s)):
+    try:
+        got = s[i]
+    except Exception as e:
+        print('s[%d] RAISED %s: %s' % (i, type(e).__name__, e))
+        continue
+    exp = list(s)[i]
+    if got != exp:
+        print('s[%d] = %r expected %r' % (i, got, exp))
+print('pop test:')
+for i in (0, 1, 50, 96, 97, -1, -97, -98):
+    t = IndexedSet(range(100))
+    for v in (99, 90, 98): t.remove(v)
+    t.add(100); t.add(101)
+    try:
+        got = t.pop(i)
+        exp = list(t)
+        expv = list(t)[i]
+        print(i, 'got', got, 'ok' if got == expv else 'MISMATCH exp %r' % expv, 'state ok' if list(t) == exp else 'STATE MISMATCH')
+    except Exception as e:
