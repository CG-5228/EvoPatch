diff -ruN -x __pycache__ -x *.pyc -x .pytest_cache -x node_modules -x *.orig -x *.rej -x .DS_Store a/out/repro.py b/out/repro.py
--- a/out/repro.py	1970-01-01 00:00:00
+++ b/out/repro.py	2026-11-06 10:34:46
@@ -0,0 +1,22 @@
+from more_itertools import zip_broadcast
+
+class OneShot:
+    def __init__(self, items):
+        self.items = items
+        self.used = False
+    def __iter__(self):
+        if self.used:
+            raise ValueError('opened twice')
+        self.used = True
+        return iter(self.items)
+
+print(list(zip(OneShot('xy'), [0, 0])))
+for label, call in [
+    ("basic", lambda: list(zip_broadcast(OneShot('xy'), 0))),
+    ("empty", lambda: list(zip_broadcast(OneShot(''), 0))),
+    ("strict", lambda: list(zip_broadcast(OneShot('xy'), OneShot('AB'), 0, strict=True))),
+]:
+    try:
+        print(label, call())
+    except Exception as e:
+        print(label, 'ERR', type(e).__name__, e)
