diff -ruN -x __pycache__ -x *.pyc -x .pytest_cache -x node_modules -x *.orig -x *.rej -x .DS_Store a/tests/test_dictutils.py b/tests/test_dictutils.py
--- a/tests/test_dictutils.py	1970-01-01 00:00:00
+++ b/tests/test_dictutils.py	2026-11-06 13:33:05
@@ -270,6 +270,35 @@
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+def test_addlist_one_shot_iterable():
+    # a generator can only be walked once; addlist must not re-iterate it
+    omd = OMD()
+    omd.addlist('a', (n * 2 for n in range(3)))
+    assert omd.getlist('a') == [0, 2, 4]
+    assert omd.get('a') == 4
+    assert list(omd.iteritems(multi=True)) == [('a', 0), ('a', 2), ('a', 4)]
+    assert omd.keys() == ['a']
+    assert 'a' in omd
+    assert omd == OMD([('a', 0), ('a', 2), ('a', 4)])
+
+    expected = OMD()
+    expected.addlist('a', [0, 2, 4])
+    assert omd == expected
+    assert repr(omd) == repr(expected)
+
+    # appending a one-shot iterable preserves existing values
+    omd.addlist('a', iter([-2]))
+    assert omd.getlist('a') == [0, 2, 4, -2]
+
+    # an empty one-shot iterable adds nothing
+    e_omd = OMD()
+    e_omd.addlist('a', (x for x in ()))
+    assert len(e_omd) == 0
+    assert e_omd.keys() == []
+    assert 'a' not in e_omd
+    assert e_omd.getlist('a') == []
+
+
