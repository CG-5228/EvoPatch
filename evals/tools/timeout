#!/usr/bin/env python3
"""Usage: tools/timeout SECONDS command [args...]. Stops the command after SECONDS, prints TIMEOUT and exits 124."""
import os
import signal
import subprocess
import sys

limit, cmd = float(sys.argv[1]), sys.argv[2:]
proc = subprocess.Popen(cmd, start_new_session=True)
try:
    sys.exit(proc.wait(timeout=limit))
except subprocess.TimeoutExpired:
    os.killpg(proc.pid, signal.SIGKILL)
    print(f"TIMEOUT after {limit:g}s: {' '.join(cmd)}")
    sys.exit(124)
