# Copy to .env (never commit .env).

# Where TrueForge runs: scripts/start-trueforge.sh serves http://localhost:8790.
TRUEFORGE_BASE_URL=http://localhost:8790

# Your model, used by npm run setup. Keys stay in .env and in TrueForge's own database.
# MODEL_PROVIDER: truefoundry, custom (any OpenAI-compatible endpoint), or a catalog type such as anthropic or openai.
MODEL_PROVIDER=truefoundry
MODEL_BASE_URL=https://gateway.truefoundry.ai
MODEL_API_KEY=
# The id the provider uses, e.g. account/model-name on the TrueFoundry gateway.
MODEL_ID=
# Lowercase letters, digits and hyphens. agent/agent.json then uses <provider name>/<alias>.
MODEL_ALIAS=
MODEL_CONTEXT_LENGTH=200000
MODEL_MAX_OUTPUT_TOKENS=16000
