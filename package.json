{
  "name": "evopatch",
  "version": "0.1.0",
  "private": true,
  "description": "A bug-fixing agent on TrueForge that tests its patches, studies its failures and rewrites its own skills.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "smoke": "tsx scripts/smoke.ts",
    "run-evals": "tsx scripts/run-evals.ts",
    "improve": "tsx scripts/improve.ts",
    "spread": "tsx scripts/spread.ts",
    "verdict": "tsx scripts/verdict.ts",
    "export-session": "tsx scripts/export-session.ts",
    "score": "tsx evals/score.ts",
    "typecheck": "tsc --noEmit",
    "mock-model": "tsx scripts/mock-model.ts",
    "probe": "tsx scripts/probe-sandbox.ts",
    "curate": "tsx scripts/curate.ts",
    "evolve": "tsx scripts/evolve.ts",
    "report": "tsx scripts/report.ts",
    "compare": "tsx scripts/report.ts compare",
    "verify-submission": "tsx scripts/verify-submission.ts",
    "rerun": "tsx scripts/run-evals.ts --kind scratch",
    "guards-selftest": "tsx scripts/guards-selftest.ts",
    "check-shim": "tsx scripts/check-shim.ts"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "0.182.0",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
